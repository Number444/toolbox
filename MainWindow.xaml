<Window x:Class="Toolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolbox.ViewModels"
        xmlns:m="clr-namespace:Toolbox.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:helpers="clr-namespace:Toolbox.Helpers"
        xmlns:corehelpers="clr-namespace:Toolbox.Core.Helpers;assembly=Toolbox.Core"
        xmlns:local="clr-namespace:Toolbox.Views"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="🧰 Toolbox"
        Height="500" Width="780"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource GlobalFont}"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SizeChanged="MainWindow_SizeChanged">

    <!-- 窗口圆角 + Mica 由代码后置 via Win32Helper -->

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CornerRadius="8"
                      CaptionHeight="36"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- 遮盖四角的暗色块（堵住 DWM 帧扩展导致的四角漏白） -->
    <Grid>
        <Path x:Name="CornerMask"
              Fill="{StaticResource BgDarkBrush}"
              IsHitTestVisible="False"/>

        <!-- 外层 Border —— 强制裁剪内容为 Win11 圆角，Margin=-1 切掉白边 -->
        <Border CornerRadius="8" ClipToBounds="True"
                Margin="-1">

    <!-- ====== 主布局 ====== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>   <!-- 标题栏 -->
            <RowDefinition Height="*"/>    <!-- 内容区 -->
            <RowDefinition Height="28"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ▸ 自定义标题栏（Acrylic 毛玻璃透入） -->
        <Border Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>   <!-- 设置按钮 -->
                    <ColumnDefinition Width="Auto"/>   <!-- 窗口控制按钮 -->
                </Grid.ColumnDefinitions>

                <!-- 左侧标题 -->
                <TextBlock Text="🧰 Toolbox"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>

                <!-- 齿轮设置按钮 -->
                <Button x:Name="SettingsButton" Grid.Column="1"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="SettingsButton_Click">
                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61
                         l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41
                         h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22
                         L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58
                         c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94
                         l0.36,2.54c0.04,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94
                         l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z
                         M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                          Fill="{StaticResource TextPrimaryBrush}"
                          Width="18" Height="18"
                          Stretch="Uniform"/>
                </Button>

                <!-- 右侧窗口控制按钮 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <!-- 最小化 -->
                    <Button x:Name="MinimizeButton"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MinimizeButton_Click">
                        <Path Data="M0,5 L10,5" Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <!-- 最大化/还原 -->
                    <Button x:Name="MaximizeButton"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MaximizeButton_Click">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizePath"
                                  Data="M0,0 L10,0 L10,10 L0,10 Z"
                                  Stroke="{StaticResource TextPrimaryBrush}"
                                  StrokeThickness="1.2"/>
                            <Grid x:Name="RestorePath" Visibility="Collapsed">
                                <Path Data="M3,0 L10,0 L10,7 L3,7 Z"
                                      Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.2"/>
                                <Path Data="M0,3 L7,3 L7,10 L0,10 Z"
                                      Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.2"
                                      Fill="{StaticResource BgSurfaceBrush}"/>
                            </Grid>
                        </Grid>
                    </Button>
                    <!-- 关闭 -->
                    <Button x:Name="CloseButton"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ▸ 主体内容区：ContentSharpLayer = 入场淡入容器（Opacity 代码驱动）+ 对焦模糊载体
             （初版方案：直接 BlurEffect 半径动画——VisualBrush 覆盖层镜像在滑动中的内容上
             会产生残影，2026-08-19 弃用回退；接受半径整数量化的有限跳档，实测观感可接受。
             完成后代码置 null 摘除 Effect） -->
        <Grid Grid.Row="1">
            <Grid x:Name="ContentSharpLayer" Opacity="0">
                <Grid.Effect>
                    <BlurEffect x:Name="ContentBlur" Radius="0"/>
                </Grid.Effect>
                <Grid x:Name="ContentRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>   <!-- 左侧导航栏 -->
                <ColumnDefinition Width="1"/>     <!-- 分隔线 -->
                <ColumnDefinition Width="*"/>     <!-- 右侧内容区 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（搜索框 + 手风琴分组 + 浮动高亮移动动画 + 自定义滚动条） -->
            <Border Grid.Column="0" x:Name="NavPane"
                    Background="#992D2D2D">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NavPaneTransform"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 搜索框 -->
                        <RowDefinition Height="*"/>       <!-- 导航列表 -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 搜索框 -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                            Background="#662D2D2D"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 矢量放大镜（替换 emoji，与标题栏齿轮同风格） -->
                            <Path Data="M0.75,5.5 a4.75,4.75 0 1,0 9.5,0 a4.75,4.75 0 1,0 -9.5,0 M8.9,8.9 L13.5,13.5"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="4,0,7,0"/>
                            <Grid Grid.Column="1">
                                <!-- 输入框（提亮背景） -->
                                <TextBox x:Name="SearchInput"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         Background="#80404040"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         Padding="6,0"
                                         KeyDown="SearchBox_KeyDown"
                                         PreviewMouseWheel="SearchBox_PreviewMouseWheel"/>
                                <!-- 占位符文字（输入为空时显示） -->
                                <TextBlock Text="  搜索工具"
                                           IsHitTestVisible="False"
                                           FontSize="13"
                                           Foreground="#777777"
                                           VerticalAlignment="Center"
                                           Padding="6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- focus 底部 Accent 绿线（Win11 文本框语言；120ms 淡入 / 150ms 淡出） -->
                                <Border Height="2"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0"
                                        CornerRadius="1"
                                        Background="{StaticResource AccentBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFocused, ElementName=SearchInput}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 导航列表 -->
                    <ScrollViewer x:Name="NavScrollViewer"
                                  Grid.Row="1" Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden">
                        <Grid x:Name="NavContainer" Margin="0,4,0,0">
                            <!-- 浮动高亮指示器（Grid 层绝对定位 → 不参与 ItemsControl 布局计算） -->
                            <Border x:Name="HighlightBar"
                                    Background="{StaticResource BgHoverBrush}"
                                    CornerRadius="6"
                                    Height="36"
                                    Margin="10,0,12,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    BorderThickness="2">
                                <!-- 方案二（试效果）：边缘 toolbox 绿细线描边；独立 Brush（非共享资源）供呼吸闪烁动画 -->
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#76B580"/>
                                </Border.BorderBrush>
                                <!-- 位移走 RenderTransform（Y 动画纯渲染层，不触发每帧布局） -->
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="HighlightTransform" Y="0"/>
                                </Border.RenderTransform>
                                <!-- 左侧高亮圆角竖线 (CornerRadius=半宽=1.5 → 两端圆角不变形) -->
                                <Border HorizontalAlignment="Left"
                                        Width="3"
                                        Height="16"
                                        CornerRadius="1.5"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"/>
                            </Border>

                            <!-- 悬停高亮条（与 HighlightBar 同 Margin/圆角几何；
                                 Accent 绿 20% 透明——与导航灰底拉开区分度，同时保持文字/图标可读） -->
                            <Border x:Name="HoverBar"
                                    Background="#3376B580"
                                    CornerRadius="6"
                                    Height="36"
                                    Margin="10,0,12,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="HoverTransform" Y="0"/>
                                </Border.RenderTransform>
                            </Border>

                            <!-- 分组列表 -->
                            <ItemsControl x:Name="NavGroupsControl" ItemsSource="{Binding VisibleGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ToolGroup">
                                        <StackPanel>
                                            <!-- 分类标题头（可点击折叠） -->
                                            <!-- 几何与 HoverBar/HighlightBar 一致（Margin 10/12）：
                                                 原 Margin 6 + Padding 12 的缩进换算进 Padding（10+8=18，文字位置不变）；
                                                 Background=Transparent 使整个矩形参与命中测试（原仅文字可点） -->
                                            <Border Padding="8,8,12,8"
                                                    Margin="10,2,12,1"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    Height="38"
                                                    CornerRadius="6"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    MouseLeftButtonDown="GroupHeader_MouseLeftButtonDown"
                                                    PreviewMouseLeftButtonDown="NavItem_PressDown"
                                                    PreviewMouseLeftButtonUp="NavItem_PressUp"
                                                    MouseEnter="GroupHeader_MouseEnter"
                                                    MouseLeave="GroupHeader_MouseLeave">
                                                <!-- Freeze=False：静态 XAML 默认冻结 Freezable，冻结后无法 BeginAnimation（按压缩放） -->
                                                <Border.RenderTransform>
                                                    <ScaleTransform po:Freeze="False"/>
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 方案 D：箭头常驻（文字固定 ▸，状态由旋转表达：折叠 0° = ▸，展开 90° = ▾，
                                                         动画由 GroupHeader_MouseLeftButtonDown 的 AnimateGroupArrow 驱动）；
                                                         展开时箭头变亮（灰 → 白） -->
                                                    <Grid Width="20" Margin="0,0,6,0">
                                                        <TextBlock Text="▸"
                                                                   Tag="GroupArrow"
                                                                   FontSize="16"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                            <TextBlock.RenderTransform>
                                                                <!-- Freeze=False：静态 XAML 默认冻结 Freezable，冻结后无法 BeginAnimation -->
                                                                <RotateTransform Angle="0" po:Freeze="False"/>
                                                            </TextBlock.RenderTransform>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <!-- 分类名称：折叠灰 → 展开白（方案 D 变亮） -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CategoryName}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!-- 该分类下的工具列表（展开/折叠为渲染式动画：布局 Height 恒 0，
                                                 内容按实测高度渲染，由 Clip 几何揭示 + 兄弟元素平移，见 AnimateGroupRender） -->
                                            <Border Height="0"
                                                    Tag="GroupAnimContainer">
                                                <ItemsControl ItemsSource="{Binding Tools}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Tag="Selected"（由 MainWindow.MarkSelectedNavItem 标记）驱动选中着色。
                                                                 几何与 HoverBar/HighlightBar 一致（Margin 10/12）：
                                                                 原 Margin 30 + Padding 12 的缩进换算进 Padding（10+32=42，文字位置不变）；
                                                                 Background=Transparent 使整个矩形参与命中测试（原仅文字可点） -->
                                                            <Border Padding="32,8,12,8"
                                                                    Margin="10,1,12,1"
                                                                    Background="Transparent"
                                                                    Cursor="Hand"
                                                                    Height="36"
                                                                    CornerRadius="6"
                                                                    RenderTransformOrigin="0.5,0.5"
                                                                    MouseLeftButtonDown="NavItem_MouseLeftButtonDown"
                                                                    PreviewMouseLeftButtonDown="NavItem_PressDown"
                                                                    PreviewMouseLeftButtonUp="NavItem_PressUp"
                                                                    MouseEnter="NavItem_MouseEnter"
                                                                    MouseLeave="NavItem_MouseLeave">
                                                                <!-- Freeze=False：静态 XAML 默认冻结 Freezable，冻结后无法 BeginAnimation（按压缩放） -->
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform po:Freeze="False"/>
                                                                </Border.RenderTransform>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding IconGlyph}"
                                                                               FontSize="13"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="Selected">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Name}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               Margin="8,0,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="Selected">
                                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 搜索无结果空态（分组集合为空时显示） -->
                            <TextBlock Text="无匹配工具"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,24,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=NavGroupsControl}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ScrollViewer>
                    <helpers:CustomScrollBar Grid.Row="1" Grid.Column="1"
                                             Width="16"
                                             Margin="0,0,-3,0"
                                             TargetScrollViewer="{Binding ElementName=NavScrollViewer}"/>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <Border Grid.Column="1"
                    Background="{StaticResource BorderSubtleBrush}"
                    Width="1"/>

            <!-- 右侧内容区（带自定义滚动条） -->
            <Border Grid.Column="2"
                    Background="#66323232">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <ScrollViewer x:Name="ContentScrollViewer"
                                  Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="32,16">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="ContentPaneTransform"/>
                        </ScrollViewer.RenderTransform>
                        <StackPanel>
                            <!-- 工具标题区（与内容区同款两段式过渡：旧标题 200ms 淡出 → 新标题 400ms 淡入上滑，
                                 通过 Content=SelectedTool 复用 TransitioningContentControl，硬切消除） -->
                            <helpers:TransitioningContentControl x:Name="TitleTransitionControl" Content="{Binding SelectedTool}" SlideFromY="-8">
                                <helpers:TransitioningContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- 当前工具标题 -->
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,0,0,4"/>
                                            <!-- 当前工具描述（为空时整块折叠，不占布局空间） -->
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </helpers:TransitioningContentControl.ContentTemplate>
                            </helpers:TransitioningContentControl>

                            <!-- 分隔线 -->
                            <Rectangle Height="1"
                                       Fill="{StaticResource BorderSubtleBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- 动态工具内容（带淡入过渡动画） -->
                            <helpers:TransitioningContentControl x:Name="ContentTransitionControl" Content="{Binding CurrentContent}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <helpers:CustomScrollBar Grid.Column="1"
                                             Width="16"
                                             TargetScrollViewer="{Binding ElementName=ContentScrollViewer}"/>

                    <!-- 设置叠加层（隐藏） -->
                    <!-- 设置叠加层：模态浮层取最暗档（60%），压住下层内容保证可读性；
                         进入/退出为淡入+上滑过渡（EnterSettingsView/ExitSettingsView 驱动） -->
                    <Border x:Name="SettingsLayer"
                            Grid.ColumnSpan="2"
                            Background="#99323232"
                            Visibility="Collapsed"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <!-- 进入 0.96→1 / 退出 →0.98 缩放（与 ComboBox 绽放同语言），位移动画沿用原 TranslateTransform -->
                                <ScaleTransform x:Name="SettingsLayerScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="SettingsLayerTransform" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 自定义滚动条替代系统条（与导航/内容区同款，原为系统默认亮色样式） -->
                            <ScrollViewer x:Name="SettingsScrollViewer"
                                          Grid.Column="0"
                                          VerticalScrollBarVisibility="Hidden">
                                <local:SettingsView x:Name="SettingsViewControl"/>
                            </ScrollViewer>
                            <helpers:CustomScrollBar Grid.Column="1"
                                                     Width="16"
                                                     TargetScrollViewer="{Binding ElementName=SettingsScrollViewer}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
            </Grid>
        </Grid>

        <!-- ▸ 状态栏（Acrylic 毛玻璃透入） -->
        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center">
                    <Run Text="显示 "/>
                    <Run Text="{Binding VisibleToolCount, Mode=OneWay}"/>
                    <Run Text="/"/>
                    <Run Text="{Binding TotalToolCount, Mode=OneWay}"/>
                    <Run Text=" 个工具"/>
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0">
                    v1.8.2
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ▸ 鼠标跟随呼吸光晕（不拦截输入，渲染在最顶层，随鼠标轻微延迟移动） -->
        <Canvas x:Name="HaloLayer"
                Grid.RowSpan="3"
                IsHitTestVisible="False">
            <Ellipse x:Name="HaloEllipse"
                     Width="140" Height="140"
                     Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <!-- 10 个色标的线性径向衰减：alpha 从中心 0x40 到边缘 0x00 等差递减，无生硬折点 -->
                    <RadialGradientBrush>
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#39FFFFFF" Offset="0.11"/>
                        <GradientStop Color="#32FFFFFF" Offset="0.22"/>
                        <GradientStop Color="#2BFFFFFF" Offset="0.33"/>
                        <GradientStop Color="#24FFFFFF" Offset="0.44"/>
                        <GradientStop Color="#1CFFFFFF" Offset="0.56"/>
                        <GradientStop Color="#15FFFFFF" Offset="0.67"/>
                        <GradientStop Color="#0EFFFFFF" Offset="0.78"/>
                        <GradientStop Color="#07FFFFFF" Offset="0.89"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <!-- 呼吸缩放由代码驱动（HaloTick）：仅光晕可见时计算，替代 Forever Storyboard 常驻渲染 -->
                        <ScaleTransform x:Name="HaloScale" ScaleX="0.9" ScaleY="0.9"/>
                        <TranslateTransform x:Name="HaloTranslate"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- ▸ 交互控件边缘发光叠加层（鼠标光源照亮控件边缘，不拦截输入） -->
        <corehelpers:EdgeGlowLayer x:Name="GlowLayer"
                               Grid.RowSpan="3"
                               IsHitTestVisible="False"/>

        <!-- ▸ 启动遮罩：纯黑——与 DWM 首帧空窗帧同色，无缝衔接（灰遮罩会暴露黑→灰跳变），
             停留时长盖住 WPF 启动初期无法绘制的黑屏期（功能需求，勿缩短）；
             两段式入场（代码驱动）：① 文字虚焦聚焦+弹入 → ② 图标虚焦从文字背后滑入 + 文字右移让位；
             停留后整体淡出，同时下层内容区滑入+对焦（OnWindowLoaded；静默启动首次托盘唤起同样生效） -->
        <Border x:Name="StartupMask"
                Grid.RowSpan="3"
                Background="#FF000000"
                IsHitTestVisible="False">
            <Grid>
                <!-- 图标组（下层，阶段 2 从文字背后滑出）。三层交叉淡化结构：
                     变换在组容器上（镜像随动，无需绑定）；Fader 整体淡入沿用原 EaseIn 渐亮节奏；
                     Sharp 清晰层淡入（双重衰减 → 清晰边缘晚到）；Veil 模糊镜像淡出。
                     Veil 镜像 MaskIcon 本体（恒不透明）——镜像会继承本源透明度，
                     若镜像参与淡入的元素，模糊层被拖暗、清晰层从底下透出 → 只见光晕不见虚焦
                     （2026-08-19 审查修复） -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="MaskIconTransform" X="0"/>
                    </Grid.RenderTransform>
                    <Grid x:Name="MaskIconFader" Opacity="0">
                        <Grid x:Name="MaskIconSharp" Opacity="0">
                            <Image x:Name="MaskIcon"
                                   Source="/Assets/toolbox_icon.png"
                                   Width="32" Height="32"
                                   Stretch="Uniform"/>
                        </Grid>
                        <Rectangle x:Name="MaskIconFocusVeil" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <VisualBrush Visual="{Binding ElementName=MaskIcon}" Stretch="None"/>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <BlurEffect Radius="6"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </Grid>
                <!-- 文字组：结构同图标组（阶段 1 弹入+淡入；阶段 2 右移让位） -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="MaskTitleTransform" X="0"/>
                    </Grid.RenderTransform>
                    <Grid x:Name="MaskTitleFader" Opacity="0">
                        <Grid x:Name="MaskTitleSharp" Opacity="0">
                            <TextBlock x:Name="MaskTitle"
                                       Text="Toolbox"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Foreground="#F0F0F0"/>
                        </Grid>
                        <Rectangle x:Name="MaskTitleFocusVeil" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <VisualBrush Visual="{Binding ElementName=MaskTitle}" Stretch="None"/>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <BlurEffect Radius="8"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Border>
</Grid>
</Window>