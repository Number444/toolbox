<UserControl x:Class="Toolbox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Toolbox.Core.Services;assembly=Toolbox.Core"
             xmlns:models="clr-namespace:Toolbox.Models;assembly=Toolbox.Core">
    <StackPanel Margin="32,16">
        <!-- 标题 + 返回按钮 -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="← 返回工具箱"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    Padding="12,6"
                    FontSize="13"
                    Cursor="Hand"
                    Click="BackButton_Click"/>
            <TextBlock Grid.Column="1" Text="设置" FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- 分隔线 -->
        <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,0,0,20"/>

        <!-- 设置项卡片（带发光标记，纳入鼠标光照） -->
        <Border Background="{StaticResource BgSurfaceBrush}"
                CornerRadius="8"
                Padding="16,14"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                models:GlowCardMarker.IsGlowCard="True">
            <StackPanel>
                <CheckBox x:Name="MinimizeCheckBox"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Content="关闭按钮最小化到任务栏"
                          IsChecked="{Binding Source={x:Static services:AppSettings.Instance}, Path=MinimizeOnClose, Mode=TwoWay}"
                          Margin="0,0,0,8"/>
                <TextBlock Text="勾选后点击关闭按钮会将 Toolbox 收入任务栏而非退出程序。"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>

                <!-- 启动时自动打开悬浮窗 -->
                <CheckBox x:Name="AutoOpenCheckBox"
                          Style="{StaticResource ToggleSwitchStyle}"
                          Content="启动时自动打开悬浮窗"
                          IsChecked="{Binding Source={x:Static services:AppSettings.Instance}, Path=AutoOpenFloatWindow, Mode=TwoWay}"
                          Margin="0,16,0,0"/>

                <!-- 悬浮窗默认大小 -->
                <WrapPanel Margin="0,16,0,0">
                    <TextBlock Text="悬浮窗默认大小："
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,8,0"/>
                    <ComboBox SelectedValue="{Binding Source={x:Static services:AppSettings.Instance}, Path=MusicFloatSizeMode, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Width="120"
                              FontSize="13">
                        <ComboBoxItem Tag="Large" Content="大模式"/>
                        <ComboBoxItem Tag="Compact" Content="紧凑模式"/>
                    </ComboBox>
                </WrapPanel>

                <!-- 开机自启（滑块开关） -->
                <CheckBox Content="开机自动启动 Toolbox"
                          Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding Source={x:Static services:AppSettings.Instance}, Path=AutoStart, Mode=TwoWay}"
                          Margin="0,16,0,0"/>

                <!-- 鼠标光晕（滑块开关） -->
                <CheckBox Content="鼠标跟随光晕"
                          Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding Source={x:Static services:AppSettings.Instance}, Path=MouseHaloEnabled, Mode=TwoWay}"
                          Margin="0,16,0,0"/>

                <!-- 控件边缘发光（滑块开关） -->
                <CheckBox Content="控件边缘发光（鼠标照亮效果）"
                          Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding Source={x:Static services:AppSettings.Instance}, Path=ControlGlowEnabled, Mode=TwoWay}"
                          Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- OCR 引擎管理 -->
        <Border Background="{StaticResource BgSurfaceBrush}"
                CornerRadius="8"
                Padding="16,14"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                models:GlowCardMarker.IsGlowCard="True"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="OCR 高精度引擎"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="已下载的离线识别引擎（PaddleOCR 模型）。删除后截图识字将回退到 Windows 内置引擎，可随时重新下载。"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DeleteEngineButton" Content="删除 OCR 引擎"
                            Background="{StaticResource DangerBrush}"
                            Foreground="White"
                            Padding="14,7"
                            FontSize="13"
                            Cursor="Hand"
                            Click="DeleteEngineButton_Click"/>
                    <TextBlock x:Name="EngineStatusText"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 远程控制 -->
        <Border Background="{StaticResource BgSurfaceBrush}"
                CornerRadius="8"
                Padding="16,14"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                models:GlowCardMarker.IsGlowCard="True"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="远程控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="局域网远程控制工具的默认配置。密钥建议留空使用随机生成；手动设置的密钥以明文保存在本机（与工具内一致）。"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,12"/>

                <CheckBox Content="启动 Toolbox 时自动启动远程控制服务"
                          Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding Source={x:Static services:AppSettings.Instance}, Path=AutoStartRemoteControl, Mode=TwoWay}"
                          Margin="0,0,0,14"/>

                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="默认端口："
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,8,0"/>
                    <TextBox Text="{Binding Source={x:Static services:AppSettings.Instance}, Path=RemoteControlDefaultPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="90"
                             FontSize="13"
                             VerticalContentAlignment="Center"/>
                </WrapPanel>

                <WrapPanel>
                    <TextBlock Text="默认密钥："
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,8,0"/>
                    <TextBox Text="{Binding Source={x:Static services:AppSettings.Instance}, Path=RemoteControlDefaultKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="240"
                             FontSize="13"
                             VerticalContentAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 退出按钮 -->
        <Button x:Name="ExitButton" Content="退出 Toolbox"
                Background="{StaticResource DangerBrush}"
                Foreground="White"
                HorizontalAlignment="Left"
                Margin="0,24,0,0"
                Padding="16,8"
                FontSize="14"
                Cursor="Hand"
                Click="ExitButton_Click"/>
    </StackPanel>
</UserControl>